# Public door of the gateway: TLS, rate limits, and an access log that never contains a station secret.
# DOMAIN and ACME_EMAIL come from .env. DOMAIN=localhost gives a self-signed certificate for a local test.
{
	email {$ACME_EMAIL:admin@example.com}
	order rate_limit before reverse_proxy
}

{$DOMAIN:localhost} {
	# the same ceiling as the application's BODY_LIMIT_BYTES
	request_body {
		max_size 20MB
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				# /pts/<secret>/... becomes /pts/***/... Not anchored, any case, any run of slashes: a mistyped upload
				# address ("//pts/<secret>", "/pts//<secret>", a prefix) is not routed, but it is still logged, secret included.
				request>uri regexp "(?i)/pts/+[^/?]+" /pts/***
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# controllers: about one upload a minute each; several share a mobile address, so the ceiling is generous
	@upload path /pts /pts/*
	handle @upload {
		rate_limit {
			zone upload {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy app:8080
	}

	# the client system: a few polls a minute per station
	@api path /v1/*
	handle @api {
		rate_limit {
			zone api {
				key {remote_host}
				events 300
				window 1m
			}
		}
		reverse_proxy app:8080
	}

	# /healthz and /readyz are for the host, not the internet
	handle {
		respond "not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
