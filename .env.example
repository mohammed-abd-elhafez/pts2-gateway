# Letters and digits only: the password is placed inside the database URL. For example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
LOG_LEVEL=info
# What the capture endpoint answers to the controller until the jsonPTS reply is known.
CAPTURE_REPLY_BODY={"ok":true}
# What to do when a reading would report negative consumed fuel (a refill): allow | hold
NEGATIVE_CONSUMED_POLICY=allow
# BATCH_MAX_ITEMS=500
# Decimals of the litre quantities we send: 2 (the guide's examples) or 3. See docs/PREPRODUCTION_PROBES.md.
QUANTITY_DECIMALS=2
# Optional, with these defaults. All of them reach the app through docker-compose.yml.
# BODY_LIMIT_BYTES=20971520
# CAPTURE_REPLY_STATUS=200
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_LOCK_TIMEOUT_MS=10000

# --- production (deploy/compose.prod.yaml, deploy/*.sh) ---
# The public name of this server, and the e-mail Let's Encrypt may write to.
# DOMAIN=gateway.example.com
# ACME_EMAIL=you@example.com
# Where nightly dumps go (default /var/backups/pts2) and an rclone remote to copy them to (use a "crypt" remote).
# BACKUP_DIR=/var/backups/pts2
# RCLONE_REMOTE=crypt-s3:pts2
# A webhook that accepts {"text": "..."} (Slack, Mattermost, ...), and heartbeat URLs called after each run.
# ALERT_WEBHOOK_URL=
# BACKUP_OK_URL=
# BACKUP_FAIL_URL=
# RESTORE_TEST_OK_URL=
# RESTORE_TEST_FAIL_URL=
# HEALTH_OK_URL=
# Minutes without an upload before a station counts as silent (default 30).
# SILENT_MINUTES=30
